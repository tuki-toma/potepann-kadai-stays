<h2>宿泊施設新規登録</h2>

<%= form_with model: @room do |f| %>
    <%# エラーメッセージ表示 %>
    <% if @room.errors.any? %>
      <ul>
        <% @room.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>
    
    <div>
      <%= f.label :name,"施設名" %>
      <%= f.text_field :name %>
    </div>

    <div>
      <%= f.label :introduce,"詳細" %>
      <%= f.text_area :introduce %>
    </div>

    <div>
      <%= f.label :price,"料金" %>
      <%= f.number_field :price %>
    </div>

    <div>
      <%= f.label :address,"住所" %>
      <%= f.text_area :address %>
    </div>

    <%= f.submit "登録" %>
<% end %>