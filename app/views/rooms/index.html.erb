<h2>宿泊施設一覧</h2>

<% @rooms.each do |room| %>

    <h2><%= link_to  room.name ,room_path(room) %></h2>

    <% if room.images.attached? %>
      <%= image_tag room.images.first,size: "300x200" %>
    <% else %>
      <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", size: "300x200", alt:"デフォルト画像" %>
    <% end %>
      

    <p>紹介文<%= room.introduce %></p>
    <p>料金：<%= room.price %>円</p>
    <h3>作成日<%= room.created_at %></h3>

<% end %>

<%= link_to "検索へ", search_rooms_path %>
<%= link_to "戻る",request.referer || rooms_path %>