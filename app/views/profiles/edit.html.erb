<h2>プロフィール編集 </h2>

<%= form_with model: @user,url:profile_path,method: :patch,local:true do |f| %>
    <%# エラーメッセージ表示 %>
    <% if @user.errors.any? %>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :name,"名前" %>
      <%= f.text_field :name %>
    </div>

    <div>
      <%= f.label :image, "アイコン" %>
      <%= f.file_field :image %>
    </div>

    <div>
      <%= f.label :introduce,"自己紹介" %>
      <%= f.text_area :introduce %>
    </div>

    <%= f.submit "更新" %>
<% end %>